# ==============================================================================
# ACM Website Monorepo - .gitignore
# Covers: Root, React Frontend (Vite/Tailwind), Ruby on Rails Backend, OS & IDEs
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (NEVER COMMIT SENSITIVE KEYS)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
!.env.example
!.env.sample

# Rails Master Key & Credentials
config/master.key
config/*.key
config/credentials/*.key
*.key
.kamal/secrets*

# ------------------------------------------------------------------------------
# Frontend (React / Vite / Tailwind / Node.js)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
.pnp
.pnp.js

# Build and Output
dist/
dist-ssr/
build/
*.tsbuildinfo

# Frontend Caches
.vite/
.cache/
.eslintcache
.stylelintcache

# Package Manager Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test Coverage
coverage/
*.lcov
.nyc_output/

# ------------------------------------------------------------------------------
# Backend (Ruby on Rails / Bundler / Puma / Database)
# ------------------------------------------------------------------------------
# Bundler
/.bundle
.bundle/
vendor/bundle/

# Rails Logs & Temp Files
log/*
tmp/*
!log/.keep
!tmp/.keep
!tmp/pids/
!tmp/pids/.keep
!tmp/storage/
!tmp/storage/.keep

# Active Storage & Uploaded Files
storage/*
!storage/.keep

# SQLite Databases (if used for testing/local dev)
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
db/*.sqlite3
db/*.sqlite3-*

# Documentation
.yardoc/
_yardoc/
doc/

# ------------------------------------------------------------------------------
# Python & Tooling Environments
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
.ruby-lsp/
.byebug_history

# ------------------------------------------------------------------------------
# Editor & IDE Files
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp
*~
